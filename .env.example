# 이 파일을 .env로 복사한 뒤 로컬 환경에 맞게 수정하세요.
# 실제 API 키나 비밀번호를 이 예제 파일에 입력하지 마세요.

# 애플리케이션
APP_NAME=출처를 보여주는 대학 학사정보 AI 도우미
APP_ENV=development
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=Asia/Seoul

# 프로젝트 내부 상대 경로
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SNAPSHOT_DATA_DIR=data/snapshots
CATALOG_DIR=data/catalog
VECTOR_DB_DIR=data/vector_db
KEYWORD_INDEX_DIR=data/keyword_index
QUARANTINE_DIR=data/quarantine

# 임베딩·재정렬 모델: 코드 수정 없이 교체할 수 있습니다.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_MODEL_REVISION=
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=query: 
EMBEDDING_PASSAGE_PREFIX=passage: 
EMBEDDING_MAX_LENGTH=512
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=
RERANKER_MODEL_REVISION=

# 선택적 LLM. 비워 두면 검색 전용 모드로 실행됩니다.
LLM_PROVIDER=openai_compatible
LLM_MODEL_NAME=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# 청크 분할 초기값
CHUNK_TARGET_CHARS=600
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=100

# 검색 초기값: 평가 데이터셋으로 조정하기 전의 기본값입니다.
DENSE_TOP_K=40
KEYWORD_TOP_K=40
RERANK_TOP_K=20
EVIDENCE_TOP_K=8
RRF_K=60
DENSE_WEIGHT=0.55
KEYWORD_WEIGHT=0.45

# 수집·문서 처리 안전 제한
CRAWL_DELAY_SECONDS=2.0
CRAWL_MAX_PAGES=50
UPLOAD_MAX_MB=50
PDF_MAX_PAGES=1000
OCR_DPI=300
OCR_LANGUAGES=kor+eng
